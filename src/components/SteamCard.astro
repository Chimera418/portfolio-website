---
import BentoCard from "./BentoCard.astro";

interface Props {
  class?: string;
  style?: string;
}
const { class: className, style } = Astro.props;
---

<BentoCard
  title="Currently Playing"
  className={className}
  style={style}
  tag="LANYARD"
>
  <div class="flex flex-col justify-between h-full relative z-10 pt-1 gap-4">
    <!-- Cover + info row -->
    <div class="flex items-center gap-4">
      <div
        id="ga-cover"
        class="h-16 w-16 md:h-20 md:w-20 rounded-lg shadow-[2px_2px_0_rgba(0,0,0,0.5)] bg-surface border border-highlight-med flex items-center justify-center text-xs text-text-muted font-pixel overflow-hidden flex-shrink-0 relative"
      >
        <div class="absolute inset-0 bg-highlight-low animate-pulse"></div>
        <span class="relative z-10 animate-pulse">...</span>
      </div>

      <div class="flex-1 min-w-0 flex flex-col justify-center gap-1">
        <!-- Game name -->
        <h4
          id="ga-name"
          class="font-bold text-text-primary text-sm md:text-base truncate"
        >
          Connecting...
        </h4>
        <!-- Sub-line: rich-presence detail/state, or last-seen timestamp -->
        <p id="ga-sub" class="text-text-muted text-xs md:text-sm truncate">
          Establishing link to Lanyard
        </p>
        <!-- Status pill -->
        <div class="flex items-center gap-1.5 mt-0.5">
          <span
            id="ga-dot"
            class="w-1.5 h-1.5 rounded-full bg-text-muted flex-shrink-0 -translate-y-[1px]"
          ></span>
          <span
            id="ga-status-label"
            class="font-pixel text-[9px] uppercase tracking-widest text-text-muted"
            >Offline</span
          >
        </div>
      </div>
    </div>

    <!-- Bottom bar (dynamic link) + 100% Vault + Recent buttons -->
    <div class="flex items-center gap-2 pt-1 border-t border-highlight-med/30">
      <a
        id="ga-bottom-bar"
        href="https://steamcommunity.com/id/gamingchimera"
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-1 min-w-0 items-center justify-between gap-2.5 px-3 py-2 rounded-lg border-2 border-highlight-med bg-overlay hover:bg-surface hover:border-[#66c0f4] transition-[background-color,border-color,opacity] duration-200 group opacity-75 hover:opacity-100"
      >
        <div class="flex items-center gap-2 min-w-0">
          <!-- Steam icon -->
          <svg
            class="w-3.5 h-3.5 flex-shrink-0 text-text-muted group-hover:text-[#66c0f4] transition-colors"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"
            ></path>
          </svg>
          <span
            id="ga-bar-label"
            class="font-pixel text-[9px] uppercase tracking-wider text-text-muted truncate group-hover:text-[#66c0f4] transition-colors"
            >Steam Feed</span
          >
        </div>
        <svg
          class="w-3 h-3 text-text-muted/60 group-hover:text-[#66c0f4] group-hover:translate-x-0.5 transition-transform motion-reduce:transform-none flex-shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path d="M7 17L17 7M17 7H7M17 7v10"></path>
        </svg>
      </a>

      <!-- Achievement Ribbon 100% Vault Trigger -->
      <button
        id="ga-perfect-btn"
        type="button"
        aria-label="View 100% Completed Games Vault"
        title="100% Completion Vault (7 Perfect Games)"
        class="recent-btn flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-lg border-2 bg-overlay hover:bg-surface transition-all duration-200 cursor-pointer group"
        style="--accent:#38bdf8; border-color: rgba(56, 189, 248, 0.45);"
      >
        <svg viewBox="0 0 40 40" class="w-7 h-7 drop-shadow-sm group-hover:scale-110 transition-transform duration-150" fill="none">
          <!-- Left Ribbon Tail -->
          <path d="M 14 20 L 9 36 L 14 32 L 18 36 L 17 22 Z"
                fill="#38bdf8" stroke="#0284c7" stroke-width="1.2" stroke-linejoin="round" />
          <!-- Right Ribbon Tail -->
          <path d="M 23 22 L 22 36 L 26 32 L 31 36 L 26 20 Z"
                fill="#38bdf8" stroke="#0284c7" stroke-width="1.2" stroke-linejoin="round" />
          <!-- Rosette Outer Starburst (16 points) -->
          <path d="M 20.00,2.50 L 22.19,5.02 L 25.17,3.53 L 26.22,6.69 L 29.55,6.45 L 29.31,9.78 L 32.47,10.83 L 30.98,13.81 L 33.50,16.00 L 30.98,18.19 L 32.47,21.17 L 29.31,22.22 L 29.55,25.55 L 26.22,25.31 L 25.17,28.47 L 22.19,26.98 L 20.00,29.50 L 17.81,26.98 L 14.83,28.47 L 13.78,25.31 L 10.45,25.55 L 10.69,22.22 L 7.53,21.17 L 9.02,18.19 L 6.50,16.00 L 9.02,13.81 L 7.53,10.83 L 10.69,9.78 L 10.45,6.45 L 13.78,6.69 L 14.83,3.53 L 17.81,5.02 Z"
                fill="#38bdf8" stroke="#0284c7" stroke-width="1.2" stroke-linejoin="round" />
          <!-- Inner Gold Medallion Ring -->
          <circle cx="20" cy="16" r="8.5" fill="#f59e0b" stroke="#b45309" stroke-width="1" />
          <!-- Inner Gold Medallion Fill -->
          <circle cx="20" cy="16" r="7.2" fill="#fbbf24" />
          <!-- 100% inside Center -->
          <text x="20" y="18.2" text-anchor="middle" font-family="'Courier New', monospace" font-size="5.2" font-weight="900" fill="#78350f" letter-spacing="-0.4">100%</text>
        </svg>
      </button>

      <!-- Recent Games Trigger -->
      <button
        id="ga-recent-btn"
        type="button"
        aria-label="Show recently played games"
        title="Recent games"
        class="recent-btn flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-lg border-2 bg-overlay text-[#66c0f4] hover:bg-surface transition-all duration-200 cursor-pointer"
        style="--accent:#66c0f4; border-color: rgba(102, 192, 244, 0.45);"
      >
        <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</BentoCard>

<!-- Steam 100% Completionist Vault & Recent History Modal -->
<div
  id="ga-modal"
  class="fixed inset-0 z-[200] hidden items-center justify-center p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ga-vault-title"
>
  <div class="ga-modal-backdrop absolute inset-0 bg-black/80 backdrop-blur-md"></div>
  <div
    class="relative z-10 w-full max-w-xl bg-surface border-2 border-highlight-med rounded-xl shadow-2xl shadow-black/80 max-h-[85vh] flex flex-col overflow-hidden animate-fade-in"
  >
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-4 sm:px-5 py-3 border-b border-highlight-med/50 bg-surface-dim/90">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#66c0f4]" viewBox="0 0 24 24" fill="currentColor">
          <path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0z"/>
        </svg>
        <span class="font-mono text-xs text-text-muted/90 font-medium">
          gamingchimera
        </span>
      </div>

      <div class="flex items-center gap-2">
        <a
          id="ga-steam-link"
          href="https://steamcommunity.com/id/gamingchimera/games/?tab=perfect"
          target="_blank"
          rel="noopener noreferrer"
          title="Open Steam Profile"
          class="inline-flex items-center gap-1.5 text-xs text-text-muted hover:text-[#66c0f4] transition-colors p-1.5 rounded hover:bg-overlay"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0z"/>
          </svg>
          <span class="font-pixel text-[9px] uppercase tracking-wider hidden sm:inline">Profile</span>
        </a>
        <button
          class="ga-modal-close text-text-muted hover:text-text-primary transition-colors p-1.5 rounded hover:bg-overlay cursor-pointer"
          aria-label="Close dialog"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="px-4 sm:px-5 py-2.5 border-b border-highlight-med/30 bg-surface-dim/60 flex items-center justify-between">
      <div class="inline-flex p-0.5 rounded-lg bg-overlay/60 border border-highlight-med/40 gap-1">
        <button
          id="ga-tab-perfect"
          type="button"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-[9px] font-pixel uppercase tracking-wider transition-all duration-150 cursor-pointer bg-amber-400/15 border border-amber-400/40 text-amber-300 font-bold shadow-sm"
        >
          <svg class="w-3 h-3 fill-amber-400 flex-shrink-0 -translate-y-[0.5px]" viewBox="0 0 24 24"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
          <span>100% Vault</span>
          <span id="ga-tab-perfect-label" class="font-pixel text-[9px] opacity-75">(7)</span>
        </button>
        <button
          id="ga-tab-recent"
          type="button"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-[9px] font-pixel uppercase tracking-wider transition-all duration-150 cursor-pointer text-text-muted hover:text-[#66c0f4] border border-transparent"
        >
          <svg class="w-3 h-3 flex-shrink-0 -translate-y-[0.5px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Recent Games</span>
        </button>
      </div>

      <div class="font-mono text-[11px] text-text-muted/50 hidden sm:inline-block">
        steamcommunity.com
      </div>
    </div>
    
    <!-- List container -->
    <div id="ga-list" class="overflow-y-auto p-3 sm:p-4 flex-1 space-y-2.5">
      <p class="text-text-muted text-sm text-center py-10 font-pixel text-[10px] uppercase tracking-widest animate-pulse">
        Loading...
      </p>
    </div>
  </div>
</div>

<style>
  @keyframes pixel-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  .pixel-blink {
    animation: pixel-blink 1s step-end infinite;
  }
  .recent-btn:hover {
    border-color: var(--accent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 30%, transparent);
  }
</style>

<script is:inline>
  (function () {
    /* ── constants ─────────────────────────────────────────────────────── */
    const LS_KEY = "ga_last_game";
    const POLL_MS = 30_000;
    let pollTimer = null;
    let tickTimer = null;
    let lastFetch = 0;
    let _lastSeenTs = null;

    /* ── helpers ───────────────────────────────────────────────────────── */
    function $(id) {
      return document.getElementById(id);
    }

    function relativeTime(ms) {
      const s = Math.floor((Date.now() - ms) / 1000);
      if (s < 60) return `${s}s ago`;
      const m = Math.floor(s / 60);
      if (m < 60) return `${m}m ago`;
      const h = Math.floor(m / 60);
      const rm = m % 60;
      return rm > 0 ? `${h}h ${rm}m ago` : `${h}h ago`;
    }

    function sessionDuration(startMs) {
      const s = Math.floor((Date.now() - startMs) / 1000);
      if (s < 60) return `${s}s`;
      const m = Math.floor(s / 60);
      if (m < 60) return `${m}m`;
      const h = Math.floor(m / 60);
      const rm = m % 60;
      return rm > 0 ? `${h}h ${rm}m` : `${h}h`;
    }

    /* ── localStorage ──────────────────────────────────────────────────── */
    // Left for backward compatibility if ever needed, but now we use backend cache
    function saveGame(game) {}
    function loadGame() {
      return null;
    }

    /* ── cover art ─────────────────────────────────────────────────────── */
    function setCover(src, name) {
      const el = $("ga-cover");
      if (!el) return;
      if (src) {
        const img = document.createElement("img");
        img.src = src;
        img.alt = name;
        img.className =
          "w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-500 ease-in-out z-20";
        img.onload = () => img.classList.remove("opacity-0");
        img.onerror = () => setPixelCover(name);

        // Keep skeleton while loading
        el.innerHTML = `
        <div class="absolute inset-0 bg-highlight-low animate-pulse z-0"></div>
      `;
        el.appendChild(img);
      } else {
        setPixelCover(name);
      }
    }

    function setPixelCover(name) {
      const el = $("ga-cover");
      if (!el) return;
      let hash = 0;
      for (const c of name || "") hash = (hash * 31 + c.charCodeAt(0)) | 0;
      const hue = Math.abs(hash) % 360;
      el.innerHTML = `
      <div class="absolute inset-0 w-full h-full flex items-center justify-center z-10" style="background:hsl(${hue},40%,18%)">
        <span class="font-pixel text-[9px] text-center px-1" style="color:hsl(${hue},70%,65%)">
          ${(name || "GAME").slice(0, 4).toUpperCase()}
        </span>
      </div>`;
    }

    /* ── ticking last-seen counter ─────────────────────────────────────── */
    function startLastSeenTick(lastSeenMs) {
      _lastSeenTs = lastSeenMs;
      clearInterval(tickTimer);
      tickTimer = setInterval(() => {
        const sub = $("ga-sub");
        if (sub) sub.textContent = relativeTime(_lastSeenTs);
      }, 1000);
    }

    function stopTick() {
      clearInterval(tickTimer);
      tickTimer = null;
      _lastSeenTs = null;
    }

    /* ── link logic ────────────────────────────────────────────────────── */
    function setBottomLink(name, appId) {
      const bar = $("ga-bottom-bar");
      const label = $("ga-bar-label");
      if (!bar || !label) return;

      // We can't guarantee a Discord App ID matches a Steam App ID.
      // The safest dynamic link is a Steam store search for the game's name.
      if (name) {
        bar.href = `https://store.steampowered.com/search/?term=${encodeURIComponent(name)}`;
        bar.classList.remove(
          "pointer-events-none",
          "opacity-50",
          "cursor-default",
        );
        bar.classList.add("cursor-pointer", "group");
        label.textContent = "Play on Steam";
      } else {
        bar.href = "#";
        bar.classList.add(
          "pointer-events-none",
          "opacity-50",
          "cursor-default",
        );
        bar.classList.remove("cursor-pointer", "group");
        label.textContent = "Play on Steam";
      }
    }

    /* ── render: currently playing ─────────────────────────────────────── */
    function renderPlaying(game) {
      stopTick();

      const sessionStart = game.session_start
        ? Number(game.session_start)
        : Date.now();

      const nameEl = $("ga-name");
      if (nameEl) {
        nameEl.textContent = game.name;
        nameEl.title = game.name;
      }

      // Sub-line: prefer rich-presence detail/state, fall back to session timer
      const sub = $("ga-sub");
      if (sub) {
        const detail = [game.details, game.state].filter(Boolean).join(" · ");
        sub.textContent = detail || sessionDuration(sessionStart);
      }

      setCover(game.image, game.name);

      const dot = $("ga-dot");
      if (dot) {
        dot.className =
          "w-1.5 h-1.5 rounded-full flex-shrink-0 -translate-y-[1px] pixel-blink";
        dot.style.background = "#66c0f4";
      }

      const label = $("ga-status-label");
      if (label) {
        label.textContent = "Playing Now";
        label.style.color = "#66c0f4";
      }

      setBottomLink(game.name, game.application_id);

      // Update sub-line with live session timer every second
      clearInterval(tickTimer);
      tickTimer = setInterval(() => {
        const subEl = $("ga-sub");
        if (!subEl) return;
        const detail = [game.details, game.state].filter(Boolean).join(" · ");
        subEl.textContent = detail || sessionDuration(sessionStart);
      }, 1000);
    }

    /* ── render: last seen ─────────────────────────────────────────────── */
    function renderLastSeen(cached) {
      stopTick();

      const nameEl = $("ga-name");
      if (nameEl) {
        nameEl.textContent = cached.name;
        nameEl.title = cached.name;
      }

      const sub = $("ga-sub");
      if (sub) sub.textContent = relativeTime(cached.last_seen);

      setCover(cached.image, cached.name);

      const dot = $("ga-dot");
      if (dot) {
        dot.className =
          "w-1.5 h-1.5 rounded-full bg-text-muted flex-shrink-0 -translate-y-[1px]";
        dot.style.background = "";
      }

      const label = $("ga-status-label");
      if (label) {
        label.textContent = "Last Played";
        label.className =
          "font-pixel text-[9px] uppercase tracking-widest text-text-muted";
        label.style.color = "";
      }

      setBottomLink(cached.name, cached.app_id || cached.application_id);

      startLastSeenTick(cached.last_seen);
    }

    /* ── render: empty ─────────────────────────────────────────────────── */
    function renderEmpty() {
      stopTick();

      const nameEl = $("ga-name");
      if (nameEl) nameEl.textContent = "No Activity";

      const sub = $("ga-sub");
      if (sub) sub.textContent = "Open a game to get started";

      const el = $("ga-cover");
      if (el)
        el.innerHTML =
          '<span class="font-pixel text-[8px] text-text-muted">N/A</span>';

      const dot = $("ga-dot");
      if (dot) {
        dot.className =
          "w-1.5 h-1.5 rounded-full bg-text-muted flex-shrink-0 -translate-y-[1px]";
        dot.style.background = "";
      }

      const label = $("ga-status-label");
      if (label) {
        label.textContent = "Offline";
        label.className =
          "font-pixel text-[9px] uppercase tracking-widest text-text-muted";
        label.style.color = "";
      }

      setBottomLink(null, null);
    }

    /* ── main logic ────────────────────────────────────────────────────── */
    function handleData(data) {
      if (data && data.game) {
        renderPlaying(data.game);
      } else if (data && data.cached) {
        renderLastSeen(data.cached);
      } else {
        renderEmpty();
      }
    }

    /* ── fetch ─────────────────────────────────────────────────────────── */
    async function poll() {
      const now = Date.now();
      if (now - lastFetch < POLL_MS) return;
      lastFetch = now;

      try {
        const res = await fetch("/api/steam");
        if (!res.ok) throw new Error("non-ok");
        handleData(await res.json());
      } catch (err) {
        console.warn("[CurrentAddiction] fetch failed", err);
        renderEmpty();
      }
    }

    /* ── init ──────────────────────────────────────────────────────────── */
    poll();
    pollTimer = setInterval(poll, POLL_MS);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) {
        lastFetch = 0;
        poll();
      }
    });

    /* ── Recently played & 100% games modal ───────────────────────────── */
    const gaModal = document.getElementById("ga-modal");
    const gaRecentBtn = document.getElementById("ga-recent-btn");
    const gaPerfectBtn = document.getElementById("ga-perfect-btn");
    const gaTabRecent = document.getElementById("ga-tab-recent");
    const gaTabPerfect = document.getElementById("ga-tab-perfect");
    const gaListEl = document.getElementById("ga-list");
    
    let activeTab = "recent"; // "recent" | "perfect"
    let recentGamesCache = null;
    let perfectGamesCache = null;

    function gaEscape(str) {
      return String(str ?? "").replace(
        /[&<>"']/g,
        (c) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c],
      );
    }

    const KNOWN_RECENTS_MAP = {
      'wallpaper engine': 'https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/431960/header.jpg',
      'bodycam': 'https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2406770/header.jpg',
      'meccha chameleon': 'https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4704690/header.jpg',
      'print i love u': 'https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4796160/3dd47ea7113f34c01e6301639cc11ec9b6f58019/header.jpg?t=1791545817',
      'a plague tale: innocence': 'https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/752590/header.jpg'
    };

    function gaRenderRecent(games) {
      if (!gaListEl) return;
      if (!games || games.length === 0) {
        gaListEl.innerHTML =
          '<p class="text-text-muted text-sm text-center py-8 font-pixel text-[10px] uppercase tracking-widest leading-relaxed">No games tracked yet<br/><span class="text-[8px] opacity-70">(recently played games appear here over time)</span></p>';
        return;
      }
      gaListEl.innerHTML = `
        <div class="space-y-1.5">
          ${games.map((g) => {
            const sub = g.lastSeen ? relativeTime(g.lastSeen) : (g.playtime && g.playtime !== 'Played' ? g.playtime : "Recently played");
            const lowerName = (g.name || '').toLowerCase().trim();
            const imgSrc = g.image || KNOWN_RECENTS_MAP[lowerName] || '';
            const fallbackChars = gaEscape((g.name || 'GAME').slice(0, 3).toUpperCase());

            return `
              <a href="${gaEscape(g.url)}" target="_blank" rel="noopener noreferrer"
                 class="group flex items-center gap-3 px-3 py-2.5 rounded-lg border border-highlight-med/50 hover:border-[#66c0f4]/40 bg-surface-dim/50 hover:bg-surface-dim transition-all duration-150">
                <div class="w-14 h-9 rounded-md overflow-hidden bg-overlay flex-shrink-0 border border-highlight-med/60 group-hover:border-[#66c0f4]/30 transition-colors flex items-center justify-center">
                  ${imgSrc ? `
                    <img
                      src="${gaEscape(imgSrc)}"
                      alt=""
                      class="w-full h-full object-cover select-none"
                      loading="lazy"
                      onerror="this.parentElement.innerHTML='<span class=\\'font-pixel text-[8px] text-text-muted/60 uppercase\\'>${fallbackChars}</span>'"
                    />
                  ` : `
                    <span class="font-pixel text-[8px] text-text-muted/60 uppercase">${fallbackChars}</span>
                  `}
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-semibold text-text-primary truncate group-hover:text-[#66c0f4] transition-colors">${gaEscape(g.name)}</p>
                  <p class="text-[10px] font-mono text-text-muted/70 mt-0.5">${gaEscape(sub)}</p>
                </div>
                <svg class="w-3.5 h-3.5 text-text-muted/30 group-hover:text-[#66c0f4] transition-colors flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>`;
          }).join('')}
        </div>
      `;
    }

    function gaRenderPerfect(games) {
      if (!gaListEl) return;
      if (!games || games.length === 0) {
        gaListEl.innerHTML =
          '<p class="text-text-muted text-sm text-center py-8 font-pixel text-[10px] uppercase tracking-widest">No 100% games found</p>';
        return;
      }

      // Update the tab count badge
      const tabLabel = document.getElementById('ga-tab-perfect-label');
      if (tabLabel) tabLabel.textContent = `(${games.length})`;

      gaListEl.innerHTML = `
        <div class="space-y-1.5">
          ${games.map((g) => {
            const achText = `${g.achievements.unlocked}/${g.achievements.total}`;
            const playtime = g.playtime && g.playtime !== 'Played' && g.playtime !== '100%' ? g.playtime : null;
            const appid = Number(g.appid || g.id);
            const achievementsUrl = `https://steamcommunity.com/id/gamingchimera/stats/${appid}/?tab=achievements`;
            const KNOWN_IMG_OVERRIDES = {
              2483190: "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2483190/c53fe3362cc3267a5d34aca3e796b90963e0e23f/header_alt_assets_6.jpg?t=1793894652",
              4796160: "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4796160/3dd47ea7113f34c01e6301639cc11ec9b6f58019/header.jpg?t=1791545817"
            };
            const imgSrc = KNOWN_IMG_OVERRIDES[appid] || g.image || `https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/${appid}/header.jpg`;
            const capsuleSrc = g.capsule || '';
            const fallbackLetter = gaEscape((g.name || '').slice(0, 3));

            return `
              <a href="${gaEscape(achievementsUrl)}" target="_blank" rel="noopener noreferrer"
                 class="group flex items-center gap-3 px-3 py-2.5 rounded-lg border border-highlight-med/50 hover:border-amber-400/40 bg-surface-dim/50 hover:bg-surface-dim transition-all duration-150">
                <div class="w-14 h-9 rounded-md overflow-hidden bg-overlay flex-shrink-0 border border-highlight-med/60 group-hover:border-amber-400/30 transition-colors">
                  <img
                    src="${gaEscape(imgSrc)}"
                    alt=""
                    class="w-full h-full object-cover select-none"
                    loading="lazy"
                    onerror="if(!this.dataset.retry && '${capsuleSrc}'){this.dataset.retry='1';this.src='${gaEscape(capsuleSrc)}';}else{this.parentElement.innerHTML='<div class=\\'w-full h-full flex items-center justify-center bg-overlay\\'><span class=\\'font-pixel text-[8px] text-text-muted/60 uppercase\\'>${fallbackLetter}</span></div>';}"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-semibold text-text-primary truncate group-hover:text-amber-300 transition-colors">${gaEscape(g.name)}</p>
                  <p class="text-[10px] font-mono text-text-muted/70 mt-0.5">${playtime ? gaEscape(playtime) + ' · ' : ''}${gaEscape(achText)} ach</p>
                </div>
                <span class="font-pixel text-[8px] text-amber-400/80 group-hover:text-amber-400 transition-colors flex-shrink-0 uppercase tracking-wider">100%</span>
              </a>`;
          }).join('')}
        </div>
      `;
    }

    async function gaLoadRecent() {
      if (!gaListEl) return;
      if (recentGamesCache) {
        gaRenderRecent(recentGamesCache);
        return;
      }
      gaListEl.innerHTML = '<p class="text-text-muted text-sm text-center py-8 font-pixel text-[10px] uppercase tracking-widest animate-pulse">Loading recent games...</p>';
      try {
        const res = await fetch("/api/steam-recent");
        const data = await res.json();
        recentGamesCache = data.games || [];
        gaRenderRecent(recentGamesCache);
      } catch (err) {
        console.error("Failed to load recent games:", err);
        gaListEl.innerHTML = '<p class="text-text-muted text-sm text-center py-8 font-pixel text-[10px] uppercase tracking-widest">Failed to load</p>';
      }
    }

    async function gaLoadPerfect() {
      if (!gaListEl) return;
      if (perfectGamesCache) {
        gaRenderPerfect(perfectGamesCache);
        return;
      }
      gaListEl.innerHTML = '<p class="text-text-muted text-sm text-center py-8 font-pixel text-[10px] uppercase tracking-widest animate-pulse">Verifying 100% completions...</p>';
      try {
        const res = await fetch("/api/steam-perfect");
        const data = await res.json();
        perfectGamesCache = data.games || [];
        gaRenderPerfect(perfectGamesCache);
      } catch (err) {
        console.error("Failed to load perfect games:", err);
        gaListEl.innerHTML = '<p class="text-text-muted text-sm text-center py-8 font-pixel text-[10px] uppercase tracking-widest">Failed to load</p>';
      }
    }

    function switchTab(tab) {
      activeTab = tab;
      const BASE = "flex items-center gap-1.5 px-3 py-1.5 rounded-md text-[9px] font-pixel uppercase tracking-wider transition-all duration-150 cursor-pointer";
      if (tab === "recent") {
        gaTabRecent.className = `${BASE} bg-[#66c0f4]/15 border border-[#66c0f4]/40 text-[#66c0f4] font-bold shadow-sm`;
        gaTabPerfect.className = `${BASE} text-text-muted hover:text-[#66c0f4] border border-transparent`;
        const sl = document.getElementById("ga-steam-link");
        if (sl) sl.href = "https://steamcommunity.com/id/gamingchimera/games/";
        gaLoadRecent();
      } else {
        gaTabPerfect.className = `${BASE} bg-amber-400/15 border border-amber-400/40 text-amber-300 font-bold shadow-sm`;
        gaTabRecent.className = `${BASE} text-text-muted hover:text-amber-400 border border-transparent`;
        const sl = document.getElementById("ga-steam-link");
        if (sl) sl.href = "https://steamcommunity.com/id/gamingchimera/games/?tab=perfect";
        gaLoadPerfect();
      }
    }

    function gaOpen(defaultTab = "recent") {
      if (!gaModal) return;
      gaModal.classList.remove("hidden");
      gaModal.classList.add("flex");
      document.body.style.overflow = "hidden";
      switchTab(defaultTab);
    }

    function gaClose() {
      if (!gaModal) return;
      gaModal.classList.add("hidden");
      gaModal.classList.remove("flex");
      document.body.style.overflow = "";
    }

    if (gaRecentBtn) gaRecentBtn.addEventListener("click", () => gaOpen("recent"));
    if (gaPerfectBtn) gaPerfectBtn.addEventListener("click", () => gaOpen("perfect"));
    if (gaTabRecent) gaTabRecent.addEventListener("click", () => switchTab("recent"));
    if (gaTabPerfect) gaTabPerfect.addEventListener("click", () => switchTab("perfect"));

    if (gaModal) {
      gaModal
        .querySelector(".ga-modal-backdrop")
        ?.addEventListener("click", gaClose);
      gaModal
        .querySelector(".ga-modal-close")
        ?.addEventListener("click", gaClose);
    }
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && gaModal && !gaModal.classList.contains("hidden"))
        gaClose();
    });
  })();
</script>
