---
import type { ArchiveListItem } from '../../lib/notion/types';

export interface Props {
  entry: ArchiveListItem;
}

const { entry } = Astro.props;

const displayDate = new Date(entry.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});

// Pick a small accent class per type
const accentMap: Record<string, string> = {
  writeup: 'text-red border-red/30 bg-red/5',
  blog:    'text-sky border-sky/30 bg-sky/5',
  devlog:  'text-green border-green/30 bg-green/5',
  note:    'text-yellow border-yellow/30 bg-yellow/5',
};
const accent = accentMap[entry.type] ?? 'text-primary border-primary/30 bg-primary/5';
---

<a
  href={`/archive/${entry.type}s/${entry.slug}`}
  class="block group outline-none"
>
  <div class="flex items-start gap-4 px-4 py-3.5 rounded-xl border border-highlight-med/50 hover:border-primary/40 hover:bg-overlay/60 transition-all duration-200">

    <!-- Date column -->
    <time
      datetime={entry.date}
      class="font-pixel text-[9px] text-text-muted/60 uppercase tracking-wider whitespace-nowrap pt-0.5 min-w-[56px] text-right hidden sm:block"
    >
      {displayDate}
    </time>

    <!-- Main content -->
    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center gap-2 mb-1">
        <!-- Type badge -->
        <span class={`font-pixel text-[8px] uppercase tracking-widest px-1.5 py-0.5 rounded border ${accent}`}>
          {entry.type}
        </span>

        <!-- Mobile date -->
        <time
          datetime={entry.date}
          class="font-pixel text-[9px] text-text-muted/50 uppercase tracking-wider sm:hidden"
        >
          {displayDate}
        </time>
      </div>

      <h2 class="text-sm md:text-base font-semibold text-text-primary group-hover:text-primary transition-colors leading-snug truncate">
        {entry.title}
      </h2>

      {entry.description && (
        <p class="text-xs text-text-muted/80 mt-0.5 line-clamp-1 leading-relaxed">
          {entry.description}
        </p>
      )}

      {entry.tags && entry.tags.length > 0 && (
        <div class="flex flex-wrap gap-1 mt-2">
          {entry.tags.slice(0, 4).map(tag => (
            <span class="px-1.5 py-0.5 bg-surface border border-highlight-med/40 text-text-muted/70 text-[8px] uppercase tracking-wider font-pixel rounded">
              {tag}
            </span>
          ))}
          {entry.tags.length > 4 && (
            <span class="text-[8px] text-text-muted/40 font-pixel self-center">+{entry.tags.length - 4}</span>
          )}
        </div>
      )}
    </div>

    <!-- Arrow -->
    <svg
      class="w-3.5 h-3.5 text-text-muted/30 group-hover:text-primary/60 group-hover:translate-x-0.5 transition-all flex-shrink-0 mt-1"
      fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
    </svg>
  </div>
</a>
