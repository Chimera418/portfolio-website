        <div class="absolute left-[7px] top-2 bottom-2 w-0.5 bg-highlight-med rounded-full"></div>
        {
          timeline.map((item, idx) => (
            <div
              class="reveal relative pl-9 pb-8 last:pb-0"
              style={`transition-delay:${idx * 70}ms`}
