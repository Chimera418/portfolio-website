                  </span>
                  <span class="font-mono text-xs text-text-muted">
                    {cert.date}
                  </span>
                </div>
                <h3 class="font-bold text-lg text-text-primary group-hover:text-primary transition-colors">
                  {cert.title}
                </h3>
                <p class="text-text-muted text-sm mt-1">{cert.issuer}</p>
              </div>

              <div class="mt-4 pt-3 border-t border-highlight-med/40 flex items-center justify-between">
                <span class="font-mono text-[10px] text-text-muted/60 truncate max-w-[200px]">
                  ID: {cert.credentialId}
                </span>
                <a
                  href={cert.verifyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 font-pixel text-[10px] uppercase tracking-wider text-primary hover:text-secondary transition-colors"
                >
                  Verify
                  <svg class="w-3 h-3 -translate-y-[1px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Fun Facts -->
    <section>
      <h2
        class="text-2xl font-bold text-text-primary mb-2 flex items-center gap-4"
      >
        <svg
          class="w-6 h-6 text-tertiary"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"
          ></path></svg
        >
        Other Than That
      </h2>
      <p class="text-text-muted text-sm mb-8 ml-10">
        The stuff that doesn't go on a résumé.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          facts.map((fact) => (
            <div
              class={`bg-overlay border-2 border-highlight-med rounded-xl p-5 transition-colors group ${fact.borderColor}`}
            >
              <p class={`font-pixel text-xs tracking-wider mb-3 ${fact.chipColor}`}>
                {fact.chip}
              </p>
              <p class="font-bold text-base text-text-primary mb-1">{fact.title}</p>
              <p class="text-text-muted text-sm leading-relaxed">{fact.subtitle}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Sign-off -->
    <section class="border-t border-highlight-med pt-10 text-center">
      <p class="text-text-muted text-sm leading-relaxed max-w-lg mx-auto">
        If you made it this far, thanks for reading. Want to build something,
        break something, or just talk tech? My inbox is open.
      </p>
      <p class="font-pixel text-xs text-primary mt-4 tracking-widest">— peace</p>
    </section>
  </div>
</Layout>

<style>
  /* Scroll-reveal — timeline items only. Active only when JS adds `reveal-on`
     (so no-JS / reduced motion always sees content). */
  html.reveal-on .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  html.reveal-on .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html.reveal-on .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Scroll-reveal for the timeline items via a rAF loop reading
  // getBoundingClientRect. This site uses smooth-scroll (Lenis), which makes
  // IntersectionObserver and native "scroll" events unreliable — polling each
  // rendered frame is robust, and stops itself once everything is revealed.
  let rafId = 0;

  function initReveal() {
    const root = document.documentElement;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      root.classList.remove("reveal-on");
      return;
    }
    root.classList.add("reveal-on");

    if (rafId) cancelAnimationFrame(rafId);

    const loop = () => {
      const trigger = window.innerHeight * 0.9;
      const pending = document.querySelectorAll<HTMLElement>(
        ".reveal:not(.is-visible)",
      );
      for (const el of pending) {
        if (el.getBoundingClientRect().top < trigger) {
          el.classList.add("is-visible");
        }
      }
      if (document.querySelectorAll(".reveal:not(.is-visible)").length > 0) {
        rafId = requestAnimationFrame(loop);
      } else {
        rafId = 0;
      }
    };

    loop();
  }

  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>
