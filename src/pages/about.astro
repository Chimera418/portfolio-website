              {/* Marker: 14px dot centered on the rail (left 1 + 7 = 8px) */}
              <span class="absolute left-[1px] top-[2px] w-3.5 h-3.5 rounded-full bg-primary border-[3px] border-surface-dim"></span>
              <div class="font-pixel text-[9px] text-primary uppercase tracking-widest">
                {item.date}
              </div>
              <h3 class="font-bold text-text-primary text-base mt-2">
                {item.role}
                <span class="text-text-muted/50 px-1">·</span>
                <span class="text-primary">{item.org}</span>
              </h3>
              <p class="text-text-muted text-sm mt-1.5 max-w-[62ch] leading-relaxed">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Tech Stack -->
    <section id="skills">
      <h2
        class="text-2xl font-bold text-text-primary mb-2 flex items-center gap-4"
      >
        <svg
          class="w-6 h-6 text-secondary"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
