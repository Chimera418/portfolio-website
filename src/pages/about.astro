import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import TechStack from "../components/TechStack.astro";

// Newest-first. All roles are ongoing ("Present").
const timeline = [
  {
    date: "Dec 2025 — Present",
    role: "Research Intern",
    org: "Samsung R&D Institute India - Bangalore",
    description:
      "Samsung PRISM Program: developing an orchestrator for various 5G network deployments across 5G RAN and Core architectures, network slicing, and cloud-native systems.",
  },
  {
    date: "2026 — Present",
    role: "CTF Player",
    org: "Void Walkers",
    description:
      "More CTFs, more challenges, and hoping to actually understand heap exploitation someday.",
  },
  {
    date: "2026 — Present",
    role: "Community Core Lead",
    org: "GDSC ASEB",
    description:
      "Google Developer Student Clubs on campus. Helping run developer events and keep the chaos organized.",
  },
  {
    date: "2025 — Present",
    role: "President",
    org: "CSI Student Chapter ASEB",
    description:
      "Somehow became the person in charge. Still figuring out how that happened.",
  },
  {
    date: "2025 — Present",
    role: "CTF Player @ Web Exploitation",
    org: "Team bi0s",
    description:
      "Playing with India's #1 CTF team — web exploitation, reverse engineering, and looking at hex dumps at 3 AM.",
  },
  {
    date: "2024 — Present",
    role: "Senior Executive",
    org: "FORGE",
    description:
      "Forum of Game Engineering. Yes, the name is cool. Yes, that mattered when I joined.",
